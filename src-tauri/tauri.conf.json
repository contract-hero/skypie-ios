{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sky Pie",
  "version": "0.1.0",
  "identifier": "ai.skypie.SkyPie",
  "build": {
    "beforeDevCommand": "pnpm -C core/ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C core/ui build",
    "frontendDist": "../core/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sky Pie",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["icons/drag-icon.png"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "frameworks": ["SystemConfiguration"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["skypie"]
      },
      "mobile": [
        {
          "scheme": ["skypie"]
        }
      ]
    }
  }
}
